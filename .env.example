# Copy to .env and fill in. .env is gitignored; .env.example is not.

# The Docker Postgres from docker-compose.yml. Matches its POSTGRES_* values.
# On Vercel leave this unset: the Neon integration provides DATABASE_URL instead.
DATABASE_URI=postgres://loovio:loovio@127.0.0.1:5432/loovio

# The Vercel Blob store's token. Leave empty to keep media on local disk.
BLOB_READ_WRITE_TOKEN=

# Signs Payload's auth tokens. Any long random string; changing it logs everyone out.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=replace-me-with-32-random-bytes

# Where the admin panel and the seed script reach the site.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# The site's own address: the base for the sitemap, robots.txt and the absolute
# URLs in share cards. Decision C means nothing deploys, so this is localhost —
# lib/metadata.ts leaves metadataBase undefined if it is unset rather than
# inventing a default and baking it into every Open Graph tag.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gates the draft-preview route at /next/preview. A request needs this *and* a
# signed-in user: the secret stops the URL being guessable, the session is what
# actually authorises seeing an unpublished document.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_PUBLIC_DRAFT_SECRET=replace-me-with-32-random-bytes
