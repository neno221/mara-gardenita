{
  "name": "mara-gardenita",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "fingerprint": "tsx scripts/fingerprint.ts",
    "fingerprint:capture": "tsx scripts/fingerprint.ts --capture",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:dump": "powershell -ExecutionPolicy Bypass -File scripts/db-dump.ps1",
    "typecheck": "tsc --noEmit",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "migrate": "cross-env PAYLOAD_DB_PUSH=false NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env PAYLOAD_DB_PUSH=false NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate:status": "cross-env PAYLOAD_DB_PUSH=false NODE_OPTIONS=--no-deprecation payload migrate:status",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importMap"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.88.0",
    "@payloadcms/next": "^3.88.0",
    "@payloadcms/plugin-seo": "^3.88.0",
    "@payloadcms/richtext-lexical": "^3.88.0",
    "graphql": "^16.14.2",
    "gsap": "^3.13.0",
    "next": "^16.3.4",
    "payload": "^3.88.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "cross-env": "^10.1.0",
    "playwright": "^1.62.1",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3"
  }
}
